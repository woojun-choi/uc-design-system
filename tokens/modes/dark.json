{
  "$description": "다크 모드 덮어쓰기. solid 배경 위 흰 글자(4.5↑)와 배경 대비(3↑)를 둘 다 맞추는 단계가 45뿐이라 solid = 45, hover·pressed = 40. tone 글자(fg.brand 등)는 70 — 채도를 줄인 weak 배경(hover 포함) 위에서도 4.5 이상",
  "bg": {
    "brand": {
      "solid": {
        "$value": "{color.brand.45}"
      },
      "solid-hover": {
        "$value": "{color.brand.40}"
      },
      "solid-pressed": {
        "$value": "{color.brand.40}"
      }
    },
    "danger": {
      "solid": {
        "$value": "{color.red.45}"
      },
      "solid-hover": {
        "$value": "{color.red.40}"
      },
      "solid-pressed": {
        "$value": "{color.red.40}"
      }
    },
    "success": {
      "solid": {
        "$value": "{color.green.45}"
      },
      "solid-hover": {
        "$value": "{color.green.40}"
      },
      "solid-pressed": {
        "$value": "{color.green.40}"
      }
    },
    "warning": {
      "solid": {
        "$value": "{color.yellow.70}"
      },
      "solid-hover": {
        "$value": "{color.yellow.60}"
      },
      "solid-pressed": {
        "$value": "{color.yellow.80}"
      }
    },
    "info": {
      "solid": {
        "$value": "{color.blue.45}"
      },
      "solid-hover": {
        "$value": "{color.blue.40}"
      },
      "solid-pressed": {
        "$value": "{color.blue.40}"
      }
    },
    "overlay": {
      "$value": "#000000a6"
    }
  },
  "fg": {
    "on-warning": {
      "$value": "{color.background}"
    },
    "brand": {
      "$value": "{color.brand.70}"
    },
    "danger": {
      "$value": "{color.red.70}"
    },
    "success": {
      "$value": "{color.green.70}"
    },
    "warning": {
      "$value": "{color.yellow.70}"
    },
    "info": {
      "$value": "{color.blue.70}"
    }
  }
}